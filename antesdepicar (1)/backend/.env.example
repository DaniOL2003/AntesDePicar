# Copia este archivo como .env (o ejecuta scripts/preparar_bd.py, que lo genera).
# NUNCA subas el archivo .env a GitHub.

# PostgreSQL
DATABASE_URL=postgresql+psycopg://antesdepicar:CAMBIA_ESTA_CONTRASENA@localhost:5432/antesdepicar
# Base exclusiva para pytest: sus tablas se vacían en cada prueba. Su nombre debe contener "test".
TEST_DATABASE_URL=postgresql+psycopg://antesdepicar:CAMBIA_ESTA_CONTRASENA@localhost:5432/antesdepicar_test

# Sesiones: usa true cuando el sitio se sirva por HTTPS
COOKIE_SECURE=false

# Orígenes permitidos para el frontend, separados por coma
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Inteligencia artificial
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120
